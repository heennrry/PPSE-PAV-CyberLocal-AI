<script>


// ============================================================
// VARIABLES
// ============================================================

let conversations = [];

let currentConversationId = null;


// ============================================================
// CARGAR HISTORIAL DEL NAVEGADOR
// ============================================================

function loadSavedConversations() {

    try {

        const saved =
            localStorage.getItem(
                "cyberlocal_conversations"
            );


        if (saved) {

            conversations =
                JSON.parse(saved);

        }

    } catch (error) {

        console.error(
            "Error cargando historial:",
            error
        );

        conversations = [];

    }


    renderHistory();

}


// ============================================================
// GUARDAR HISTORIAL
// ============================================================

function saveConversations() {

    localStorage.setItem(
        "cyberlocal_conversations",
        JSON.stringify(
            conversations
        )
    );

}


// ============================================================
// GENERAR ID
// ============================================================

function generateId() {

    return Date.now().toString()
        + "-"
        + Math.random()
            .toString(36)
            .substring(2, 9);

}


// ============================================================
// NUEVA CONVERSACIÓN
// ============================================================

function newConversation() {

    currentConversationId = null;


    document.getElementById(
        "messages"
    ).innerHTML = `

        <div class="welcome">

            <h1>
                ¿En qué puedo ayudarte?
            </h1>

            <p>
                Pregunta sobre
                ciberseguridad o sobre
                tus documentos PDF.
            </p>

        </div>

    `;


    document.getElementById(
        "question"
    ).value = "";


    document.getElementById(
        "question"
    ).focus();


    renderHistory();

}


// ============================================================
// BUSCAR CONVERSACIÓN
// ============================================================

function getCurrentConversation() {

    return conversations.find(
        conversation =>
            conversation.id ===
            currentConversationId
    );

}


// ============================================================
// MOSTRAR HISTORIAL
// ============================================================

function renderHistory() {

    const history =
        document.getElementById(
            "history"
        );


    history.innerHTML = "";


    const ordered =
        [...conversations].reverse();


    ordered.forEach(
        conversation => {


            const item =
                document.createElement(
                    "div"
                );


            item.className =
                "history-item";


            if (
                conversation.id ===
                currentConversationId
            ) {

                item.classList.add(
                    "active"
                );

            }


            const title =
                document.createElement(
                    "div"
                );


            title.className =
                "history-title-text";


            title.textContent =
                conversation.title;


            const deleteButton =
                document.createElement(
                    "button"
                );


            deleteButton.className =
                "delete-button";


            deleteButton.textContent =
                "×";


            deleteButton.title =
                "Eliminar conversación";


            deleteButton.onclick =
                function(event) {

                    event.stopPropagation();

                    deleteConversation(
                        conversation.id
                    );

                };


            item.appendChild(title);

            item.appendChild(
                deleteButton
            );


            item.onclick =
                function() {

                    openConversation(
                        conversation.id
                    );

                };


            history.appendChild(item);

        }
    );

}


// ============================================================
// ABRIR CONVERSACIÓN
// ============================================================

function openConversation(id) {

    const conversation =
        conversations.find(
            item =>
                item.id === id
        );


    if (!conversation) {

        return;

    }


    currentConversationId =
        id;


    const messages =
        document.getElementById(
            "messages"
        );


    messages.innerHTML = "";


    conversation.messages.forEach(
        message => {

            addMessageToScreen(
                message.role,
                message.content
            );

        }
    );


    renderHistory();


    messages.scrollTop =
        messages.scrollHeight;

}


// ============================================================
// BORRAR CONVERSACIÓN
// ============================================================

function deleteConversation(id) {

    conversations =
        conversations.filter(
            conversation =>
                conversation.id !== id
        );


    if (
        currentConversationId === id
    ) {

        currentConversationId =
            null;


        document.getElementById(
            "messages"
        ).innerHTML = `

            <div class="welcome">

                <h1>
                    ¿En qué puedo ayudarte?
                </h1>

                <p>
                    Pregunta sobre
                    ciberseguridad o
                    tus documentos PDF.
                </p>

            </div>

        `;

    }


    saveConversations();

    renderHistory();

}


// ============================================================
// CREAR CONVERSACIÓN
// ============================================================

function createConversation(
    firstQuestion
) {

    const id =
        generateId();


    let title =
        firstQuestion.trim();


    if (
        title.length > 40
    ) {

        title =
            title.substring(
                0,
                40
            )
            + "...";

    }


    const conversation = {

        id: id,

        title: title,

        messages: []

    };


    conversations.push(
        conversation
    );


    currentConversationId =
        id;


    return conversation;

}


// ============================================================
// AÑADIR MENSAJE A PANTALLA
// ============================================================

function addMessageToScreen(
    role,
    content
) {

    const messages =
        document.getElementById(
            "messages"
        );


    const welcome =
        messages.querySelector(
            ".welcome"
        );


    if (welcome) {

        welcome.remove();

    }


    const message =
        document.createElement(
            "div"
        );


    message.className =
        "message";


    const avatar =
        document.createElement(
            "div"
        );


    avatar.className =
        "avatar "
        +
        (
            role === "user"
                ? "user-avatar"
                : "ai-avatar"
        );


    avatar.textContent =
        role === "user"
            ? "Tú"
            : "AI";


    const body =
        document.createElement(
            "div"
        );


    body.className =
        "message-body";


    const name =
        document.createElement(
            "div"
        );


    name.className =
        "message-name";


    name.textContent =
        role === "user"
            ? "Tú"
            : "CyberLocal AI";


    const text =
        document.createElement(
            "div"
        );


    text.className =
        "message-text";


    text.textContent =
        content;


    body.appendChild(name);

    body.appendChild(text);


    message.appendChild(avatar);

    message.appendChild(body);


    messages.appendChild(message);


    messages.scrollTop =
        messages.scrollHeight;

}


// ============================================================
// INDICADOR DE CARGA
// ============================================================

function addLoadingMessage() {

    const messages =
        document.getElementById(
            "messages"
        );


    const message =
        document.createElement(
            "div"
        );


    message.className =
        "message";


    message.id =
        "loading-message";


    const avatar =
        document.createElement(
            "div"
        );


    avatar.className =
        "avatar ai-avatar";


    avatar.textContent =
        "AI";


    const body =
        document.createElement(
            "div"
        );


    body.className =
        "message-body";


    const name =
        document.createElement(
            "div"
        );


    name.className =
        "message-name";


    name.textContent =
        "CyberLocal AI";


    const text =
        document.createElement(
            "div"
        );


    text.className =
        "message-text typing";


    text.textContent =
        "Pensando...";


    body.appendChild(name);

    body.appendChild(text);


    message.appendChild(avatar);

    message.appendChild(body);


    messages.appendChild(message);


    messages.scrollTop =
        messages.scrollHeight;

}


// ============================================================
// QUITAR CARGA
// ============================================================

function removeLoadingMessage() {

    const loading =
        document.getElementById(
            "loading-message"
        );


    if (loading) {

        loading.remove();

    }

}


// ============================================================
// ENVIAR MENSAJE
// ============================================================

async function sendMessage() {

    const textarea =
        document.getElementById(
            "question"
        );


    const button =
        document.getElementById(
            "sendButton"
        );


    const question =
        textarea.value.trim();


    if (!question) {

        return;

    }


    // Crear conversación si no existe

    if (!currentConversationId) {

        createConversation(
            question
        );

    }


    const conversation =
        getCurrentConversation();


    if (!conversation) {

        return;

    }


    // Mostrar mensaje

    addMessageToScreen(
        "user",
        question
    );


    // Guardar mensaje

    conversation.messages.push({

        role: "user",

        content: question

    });


    saveConversations();


    textarea.value = "";

    textarea.style.height =
        "auto";


    button.disabled = true;

    button.textContent =
        "…";


    addLoadingMessage();


    try {


        const response =
            await fetch(
                "/ask",
                {

                    method: "POST",

                    headers: {

                        "Content-Type":
                            "application/json"

                    },

                    body:
                        JSON.stringify({

                            question:
                                question,

                            history:
                                conversation.messages

                        })

                }
            );


        const data =
            await response.json();


        removeLoadingMessage();


        if (!response.ok) {

            throw new Error(
                data.detail ||
                "Error del servidor"
            );

        }


        const answer =
            data.answer ||
            "No se recibió respuesta.";


        conversation.messages.push({

            role: "assistant",

            content: answer

        });


        saveConversations();


        addMessageToScreen(
            "assistant",
            answer
        );


        renderHistory();


    } catch (error) {


        removeLoadingMessage();


        const errorMessage =
            "❌ Error: "
            + error.message;


        conversation.messages.push({

            role: "assistant",

            content:
                errorMessage

        });


        saveConversations();


        addMessageToScreen(
            "assistant",
            errorMessage
        );

    }


    button.disabled = false;

    button.textContent =
        "↑";


    textarea.focus();

}


// ============================================================
// ENTER PARA ENVIAR
// SHIFT + ENTER = SALTO DE LÍNEA
// ============================================================

function handleKey(event) {

    if (
        event.key === "Enter"
        &&
        !event.shiftKey
    ) {

        event.preventDefault();

        sendMessage();

    }

}


// ============================================================
// AUTO AJUSTE DEL TEXTAREA
// ============================================================

document
    .getElementById(
        "question"
    )
    .addEventListener(
        "input",
        function() {

            this.style.height =
                "auto";


            this.style.height =
                Math.min(
                    this.scrollHeight,
                    180
                )
                + "px";

        }
    );


// ============================================================
// INICIO
// ============================================================

loadSavedConversations();

</script>


</body>

</html>
"""


# ============================================================
# PÁGINA PRINCIPAL
# ============================================================

@app.get(
    "/",
    response_class=HTMLResponse
)
def home():

    return HTML


# ============================================================
# SUBIR PDF
# ============================================================

@app.post(
    "/upload"
)
async def upload(
    file: UploadFile = File(...)
):

    if not file.filename.lower().endswith(
        ".pdf"
    ):

        return HTMLResponse(
            """
            <h2>
                Solo se permiten archivos PDF.
            </h2>

            <a href="/">
                Volver
            </a>
            """,
            status_code=400
        )


    os.makedirs(
        DOCUMENTS_DIR,
        exist_ok=True
    )


    safe_filename =
        os.path.basename(
            file.filename
        )


    path = os.path.join(
        DOCUMENTS_DIR,
        safe_filename
    )


    contents =
        await file.read()


    with open(
        path,
        "wb"
    ) as f:

        f.write(contents)


    print(
        f"PDF subido: {safe_filename}"
    )


    return RedirectResponse(
        url="/",
        status_code=303
    )


# ============================================================
# CHAT
# ============================================================

@app.post("/ask")
async def ask(
    data: dict
):

    question = data.get(
        "question",
        ""
    )


    question = str(
        question
    ).strip()


    history = data.get(
        "history",
        []
    )


    if not question:

        return {
            "answer":
                "Escribe una pregunta."
        }


    print(
        "Pregunta recibida:",
        question
    )


    # Buscar información en PDFs

    context =
        find_relevant_context(
            question
        )


    try:

        answer =
            ask_ollama(
                question,
                context,
                history
            )


    except requests.exceptions.ConnectionError:

        answer = (
            "❌ No puedo conectar con Ollama.\n\n"
            "Comprueba que el contenedor "
            "cyberlocal-ollama está funcionando."
        )


    except requests.exceptions.Timeout:

        answer = (
            "❌ Ollama ha tardado demasiado "
            "en responder."
        )


    except Exception as e:

        print(
            "ERROR:",
            str(e)
        )


        answer = (
            "❌ Ha ocurrido un error "
            "al consultar la IA.\n\n"
            + str(e)
        )


    print(
        "Respuesta generada."
    )


    return {

        "answer":
            answer

    }


# ============================================================
# HEALTH CHECK
# ============================================================

@app.get("/health")
def health():

    return {

        "status":
            "ok",

        "model":
            MODEL,

        "ollama":
            OLLAMA_URL

    }
