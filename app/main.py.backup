import os
import re
import requests

from fastapi import FastAPI, UploadFile, File
from fastapi.responses import HTMLResponse, RedirectResponse
from pypdf import PdfReader


app = FastAPI(title="CyberLocal AI")


# ============================================================
# CONFIGURACIÓN
# ============================================================

DOCUMENTS_DIR = "/documents"

OLLAMA_URL = os.getenv(
    "OLLAMA_URL",
    "http://ollama:11434/api/generate"
)

MODEL = os.getenv(
    "MODEL",
    "llama3.2:3b"
)


# ============================================================
# FUNCIONES PARA PDF
# ============================================================

def clean_text(text):
    """
    Limpia espacios innecesarios del texto.
    """

    text = text.replace("\x00", " ")

    text = re.sub(
        r"\s+",
        " ",
        text
    )

    return text.strip()


def extract_pdf_text(path):
    """
    Extrae el texto de un PDF.
    """

    reader = PdfReader(path)

    pages = []

    for page in reader.pages:

        try:

            text = page.extract_text() or ""

            pages.append(text)

        except Exception as e:

            print(
                f"Error leyendo página del PDF: {e}"
            )

    return clean_text(
        "\n".join(pages)
    )


def split_text(
    text,
    chunk_size=1200
):
    """
    Divide el texto en pequeños bloques.
    """

    chunks = []

    for i in range(
        0,
        len(text),
        chunk_size
    ):

        chunk = text[
            i:i + chunk_size
        ]

        if chunk.strip():

            chunks.append(
                chunk.strip()
            )

    return chunks


def get_all_documents():
    """
    Obtiene todos los PDFs de /documents.
    """

    documents = []

    os.makedirs(
        DOCUMENTS_DIR,
        exist_ok=True
    )

    for filename in os.listdir(
        DOCUMENTS_DIR
    ):

        if not filename.lower().endswith(
            ".pdf"
        ):

            continue

        path = os.path.join(
            DOCUMENTS_DIR,
            filename
        )

        try:

            text = extract_pdf_text(
                path
            )

            if text:

                documents.append(
                    {
                        "filename": filename,
                        "text": text
                    }
                )

        except Exception as e:

            print(
                f"Error procesando "
                f"{filename}: {e}"
            )

    return documents


# ============================================================
# BÚSQUEDA EN LOS PDF
# ============================================================

def find_relevant_context(
    question
):
    """
    Busca los fragmentos del PDF
    más relacionados con la pregunta.
    """

    documents = get_all_documents()

    if not documents:

        return ""


    question_words = set(
        re.findall(
            r"\b[a-zA-ZáéíóúÁÉÍÓÚñÑ0-9]{3,}\b",
            question.lower()
        )
    )


    results = []


    for document in documents:

        chunks = split_text(
            document["text"]
        )

        for chunk in chunks:

            chunk_words = set(
                re.findall(
                    r"\b[a-zA-ZáéíóúÁÉÍÓÚñÑ0-9]{3,}\b",
                    chunk.lower()
                )
            )


            score = len(
                question_words.intersection(
                    chunk_words
                )
            )


            if score > 0:

                results.append(
                    (
                        score,
                        document["filename"],
                        chunk
                    )
                )


    results.sort(
        key=lambda item: item[0],
        reverse=True
    )


    selected = results[:5]


    context_parts = []


    for score, filename, chunk in selected:

        context_parts.append(
            "[Documento: "
            + filename
            + "]\n"
            + chunk
        )


    return "\n\n".join(
        context_parts
    )


# ============================================================
# PREPARAR HISTORIAL
# ============================================================

def prepare_history(history):
    """
    Convierte el historial del navegador
    en texto para Ollama.
    """

    if not isinstance(
        history,
        list
    ):

        return ""


    history_text = []


    # Solo usamos los últimos 10 mensajes
    # para no hacer el prompt demasiado grande.

    for message in history[-10:]:

        if not isinstance(
            message,
            dict
        ):

            continue


        role = message.get(
            "role",
            ""
        )

        content = message.get(
            "content",
            ""
        )


        if not content:

            continue


        if role == "user":

            history_text.append(
                "Usuario: "
                + str(content)
            )


        elif role == "assistant":

            history_text.append(
                "CyberLocal AI: "
                + str(content)
            )


    return "\n".join(
        history_text
    )


# ============================================================
# OLLAMA
# ============================================================

def ask_ollama(
    question,
    context,
    history
):
    """
    Envía la pregunta a Ollama.
    """

    history_text = prepare_history(
        history
    )


    if context:

        prompt = f"""
Eres CyberLocal AI.

Eres un asistente local especializado
en ciberseguridad y análisis de documentos.

Responde siempre en español.

Debes responder de forma clara y sencilla.

Puedes utilizar el historial de la conversación
para mantener el contexto.

La documentación PDF proporcionada es una
fuente importante de información.

Si la respuesta aparece en el PDF,
utiliza esa información.

No inventes información que contradiga
la documentación.

Si la información no aparece en el PDF,
puedes utilizar tus conocimientos generales,
pero indícalo claramente.

HISTORIAL DE LA CONVERSACIÓN:

{history_text}

DOCUMENTACIÓN RELEVANTE:

{context}

PREGUNTA ACTUAL:

{question}

RESPUESTA:
"""

    else:

        prompt = f"""
Eres CyberLocal AI.

Eres un asistente local especializado
en ciberseguridad.

Responde siempre en español.

Responde de forma clara y sencilla.

Puedes utilizar el historial de conversación
para mantener el contexto.

En esta pregunta no se ha encontrado
documentación PDF relevante.

Puedes responder utilizando tus conocimientos
generales.

HISTORIAL:

{history_text}

PREGUNTA:

{question}

RESPUESTA:
"""


    payload = {
        "model": MODEL,
        "prompt": prompt,
        "stream": False,
        "options": {
            "temperature": 0
        }
    }


    response = requests.post(
        OLLAMA_URL,
        json=payload,
        timeout=180
    )


    response.raise_for_status()


    data = response.json()


    return data.get(
        "response",
        "No se recibió respuesta del modelo."
    )


